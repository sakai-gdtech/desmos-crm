{
  "name": "@orbit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:migrate": "tsx src/infrastructure/migrate.ts",
    "db:seed": "tsx src/infrastructure/seed.ts",
    "worker": "tsx src/infrastructure/worker.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.1",
    "jose": "^6.1.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
